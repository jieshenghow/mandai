# Local development values only. Copy to .env before running services.
DATABASE_URL=postgresql://mandai:mandai_local@localhost:5432/mandai_assessment?schema=public
POSTGRES_USER=mandai
POSTGRES_PASSWORD=mandai_local
POSTGRES_DB=mandai_assessment
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret-before-starting-the-api

# Optional absolute path; default is <repository>/uploads. Mount persistent storage in deployment.
# UPLOAD_DIR=/absolute/path/to/uploads
